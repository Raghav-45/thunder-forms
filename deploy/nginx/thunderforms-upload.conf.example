# Put these two zones in nginx's `http` block, once for the server.
limit_req_zone $binary_remote_addr zone=thunderforms_uploads:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=thunderforms_clients:10m;

# Put this location inside the HTTPS `server` block that proxies ThunderForms.
location ~ ^/api/forms/[^/]+/uploads$ {
    client_max_body_size 12m;
    limit_req zone=thunderforms_uploads burst=4 nodelay;
    limit_req_status 429;
    limit_conn thunderforms_clients 2;
    limit_conn_status 429;

    # Preserve the application's streaming upload path instead of writing the
    # complete request body to Nginx's temporary-file buffer first.
    proxy_request_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://127.0.0.1:3000;
}
