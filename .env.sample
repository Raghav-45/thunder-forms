# ─── PostgreSQL ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/thunderforms"
DIRECT_URL="postgresql://user:password@localhost:5432/thunderforms"

# ─── Better Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your_better_auth_secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Google Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"

# ─── Analytics Database ───────────────────────────────────────────────
ANALYTICS_DATABASE_URL="your_analytics_database_url"

# ─── Google Service Account (Google Forms Import) ─────────────────────
NEXT_PUBLIC_GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your_private_key"

# ─── GitHub OAuth ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
