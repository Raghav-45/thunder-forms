# ─── PostgreSQL ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/thunderforms"
DIRECT_URL="postgresql://user:password@localhost:5432/thunderforms"

# ─── Better Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your_better_auth_secret"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Google Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY="your_gemini_api_key"

# ─── Analytics Database ───────────────────────────────────────────────
ANALYTICS_DATABASE_URL="your_analytics_database_url"

# ─── Google Service Account (Google Forms Import) ─────────────────────
NEXT_PUBLIC_GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account_email"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="your_private_key"

# ─── Google Sheets Integration ───────────────────────────────────────
# Enable Google Sheets API, Google Drive API, and Google Picker API in this Cloud project.
# Register the exact callback URL below as a Web OAuth client redirect URI.
GOOGLE_SHEETS_OAUTH_CLIENT_ID="your_web_oauth_client_id"
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET="your_web_oauth_client_secret"
GOOGLE_SHEETS_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google-sheets/callback"
# Generate with: openssl rand -base64 32
GOOGLE_SHEETS_TOKEN_ENCRYPTION_KEY="your_32_byte_base64_key"
GOOGLE_SHEETS_SYNC_SECRET="your_scheduler_secret"
# Configure your deployment scheduler to POST this route with
# Authorization: Bearer $GOOGLE_SHEETS_SYNC_SECRET at least once per minute.
# /api/internal/google-sheets/sync
# Restrict this public browser key to approved app origins and Google Picker API.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY="your_restricted_picker_api_key"
NEXT_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER="your_google_cloud_project_number"

# ─── Google Forms Import ──────────────────────────────────────────────
# Register the exact callback URL below as a Web OAuth client redirect URI
# (same Cloud client as Sheets when GOOGLE_FORMS_IMPORT_OAUTH_CLIENT_ID/SECRET are unset).
GOOGLE_FORMS_IMPORT_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/google-forms-import/callback"

# ─── GitHub OAuth ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
