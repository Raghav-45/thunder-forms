generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin
}

model user {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  displayName   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions     session[]
  accounts     account[]
  forms        forms[]
}

model session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String   @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model profiles {
  id           String  @id
  email        String  @db.VarChar(256)
  display_name String? @db.VarChar(256)
}

model forms {
  id                String    @id @default(cuid())
  title             String
  description       String?
  fields            Json
  createdAt         DateTime  @default(now())
  expiresAt         DateTime?
  maxSubmissions    Int?
  redirectUrl       String?
  submitButtonText  String?

  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  responses responses[]
  template  templates?
}

model responses {
  id        String   @id @default(cuid())
  data      Json
  createdAt DateTime @default(now())

  forms   forms  @relation(fields: [formsId], references: [id], onDelete: Cascade)
  formsId String
}

model templates {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  createdBy    String
  createdAt    DateTime @default(now())
  thumbnailUrl String

  form   forms  @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId String @unique
}
