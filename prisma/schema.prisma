generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum GoogleSheetsConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
}

enum GoogleSheetsIntegrationStatus {
  ACTIVE
  PAUSED
}

enum GoogleSheetsDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  SYNCED
  FAILED
}

enum FileUploadConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
}

enum FileUploadStatus {
  UPLOADING
  PENDING
  ATTACHED
}

model user {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  displayName   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                  session[]
  accounts                  account[]
  forms                     forms[]
  googleSheetsConnection    google_sheets_connections?
  googleSheetsOAuthAttempts google_sheets_oauth_attempts[]
  googleSheetsSetupLocks    google_sheets_setup_locks[]
  googleFormsImportAttempts google_forms_import_attempts[]
  fileUploadConnection      file_upload_connections?
  fileUploadOAuthAttempts   file_upload_oauth_attempts[]
}

model session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String   @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model profiles {
  id           String  @id
  email        String  @db.VarChar(256)
  display_name String? @db.VarChar(256)
}

model forms {
  id               String    @id @default(cuid())
  title            String
  description      String?
  fields           Json
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  maxSubmissions   Int?
  redirectUrl      String?
  submitButtonText String?
  submitAnotherResponseText String?
  returnToHomepageText      String?
  showSubmitAnotherResponse Boolean @default(true)
  showReturnToHomepage      Boolean @default(true)
  successExtraButtons       Json?
  successTitle      String?
  successMessage    String?
  successBlockOrder Json?
  userId           String

  user                      user                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses                 responses[]
  template                  templates?
  googleSheetsIntegration   google_sheets_integrations?
  googleSheetsOAuthAttempts google_sheets_oauth_attempts[]
  googleSheetsSetupLock     google_sheets_setup_locks?
  fileUploadOAuthAttempts   file_upload_oauth_attempts[]
  fileUploadDestinations    file_upload_destinations[]
  fileUploads               file_uploads[]
  fileUploadSessions        file_upload_sessions[]
}

model responses {
  id        String   @id @default(cuid())
  data      Json
  createdAt DateTime @default(now())
  formsId   String

  forms                  forms                       @relation(fields: [formsId], references: [id], onDelete: Cascade)
  googleSheetsDeliveries google_sheets_deliveries[]
  fileUploads            file_uploads[]
}

model file_upload_connections {
  id                    String                     @id @default(cuid())
  userId                String                     @unique
  encryptedRefreshToken String
  grantedScopes         String
  status                FileUploadConnectionStatus @default(ACTIVE)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  user         user                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations file_upload_destinations[]
}

model file_upload_oauth_attempts {
  state                 String   @id
  encryptedCodeVerifier String
  userId                String
  formId                String
  fieldId               String
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  user user  @relation(fields: [userId], references: [id], onDelete: Cascade)
  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model file_upload_destinations {
  id           String   @id @default(cuid())
  formId       String
  fieldId      String
  connectionId String
  provider     String
  folderId     String
  folderName   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  form       forms                   @relation(fields: [formId], references: [id], onDelete: Cascade)
  connection file_upload_connections @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  uploads    file_uploads[]

  @@unique([formId, fieldId])
  @@index([formId])
}

model file_uploads {
  id            String           @id @default(cuid())
  formId        String
  fieldId       String
  sessionId     String?
  destinationId String
  storageKey    String
  fileName      String
  mimeType      String
  sizeBytes     Int
  status        FileUploadStatus @default(PENDING)
  responseId    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  form        forms                  @relation(fields: [formId], references: [id], onDelete: Cascade)
  destination file_upload_destinations @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  response    responses?              @relation(fields: [responseId], references: [id], onDelete: SetNull)
  session     file_upload_sessions?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([formId, fieldId, sessionId, status])
  @@index([status, createdAt])
}

model file_upload_sessions {
  id        String   @id
  formId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  form    forms          @relation(fields: [formId], references: [id], onDelete: Cascade)
  uploads file_uploads[]

  @@index([formId, expiresAt])
}

model google_sheets_connections {
  id                    String                       @id @default(cuid())
  userId                String                       @unique
  encryptedRefreshToken String
  grantedScopes         String
  status                GoogleSheetsConnectionStatus @default(ACTIVE)
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  user         user                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrations google_sheets_integrations[]
}

model google_sheets_oauth_attempts {
  state                 String   @id
  encryptedCodeVerifier String
  userId                String
  formId                String
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  user user  @relation(fields: [userId], references: [id], onDelete: Cascade)
  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model google_sheets_integrations {
  id               String                        @id @default(cuid())
  formId           String                        @unique
  connectionId     String
  spreadsheetId    String
  spreadsheetUrl   String
  spreadsheetTitle String
  sheetId          Int
  sheetTitle       String
  headers          Json
  status           GoogleSheetsIntegrationStatus @default(ACTIVE)
  lastSyncedAt     DateTime?
  lastError        String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  form       forms                     @relation(fields: [formId], references: [id], onDelete: Cascade)
  connection google_sheets_connections @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  deliveries google_sheets_deliveries[]

  @@unique([connectionId, spreadsheetId, sheetId])
}

model google_sheets_setup_locks {
  formId    String   @id
  userId    String
  createdAt DateTime @default(now())

  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)
  user user  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model google_forms_import_attempts {
  state                 String   @id
  encryptedCodeVerifier String?
  encryptedAccessToken  String?
  userId                String
  returnTo              String
  expiresAt             DateTime
  createdAt             DateTime @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model google_sheets_deliveries {
  id            String                     @id @default(cuid())
  integrationId String
  responseId    String
  row           Json
  status        GoogleSheetsDeliveryStatus @default(PENDING)
  attemptCount  Int                        @default(0)
  nextAttemptAt DateTime                   @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  syncedAt      DateTime?
  updatedRange  String?
  lastErrorCode String?
  lastError     String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  integration google_sheets_integrations @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  response    responses                  @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([integrationId, responseId])
  @@index([status, nextAttemptAt])
}

model templates {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  createdBy    String
  createdAt    DateTime @default(now())
  thumbnailUrl String
  formId       String   @unique

  form forms @relation(fields: [formId], references: [id], onDelete: Cascade)
}
